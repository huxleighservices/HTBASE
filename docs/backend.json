
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user within the HTBase.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "firstName": {
          "type": "string",
          "description": "First name of the user."
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the user."
        },
        "email": {
          "type": "string",
          "description": "Email address of the user.",
          "format": "email"
        },
        "role": {
          "type": "string",
          "description": "The role of the user.",
          "enum": ["admin", "manager", "user"]
        },
        "assignedClientId": {
            "type": "string",
            "description": "The 6-digit display ID of the client assigned to a manager."
        }
      },
      "required": [
        "id",
        "email"
      ]
    },
    "Client": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Client",
      "type": "object",
      "description": "Represents a client of the user.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Client entity."
        },
        "displayId": {
          "type": "string",
          "description": "A random 6-character ID for display purposes."
        },
        "firmName": {
          "type": "string"
        },
        "legalFirstName": {
          "type": "string"
        },
        "legalLastName": {
          "type": "string"
        },
        "firmSize": {
          "type": "string"
        },
        "firmEstYear": {
          "type": "string"
        },
        "industry": {
          "type": "string"
        },
        "contactEmail": {
          "type": "string",
          "format": "email"
        },
        "contactPhoneNumber": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "active", "archived"]
        },
        "trainingData": {
          "type": "string",
          "description": "Custom product information or training material for the AI."
        }
      },
      "required": [
        "id",
        "displayId",
        "firmName",
        "contactEmail",
        "status"
      ]
    },
    "AccessKey": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AccessKey",
      "type": "object",
      "description": "Represents a temporary user credential for client access.",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique ID for the access key document."
        },
        "username": {
          "type": "string",
          "description": "The username for the access key."
        },
        "password": {
          "type": "string",
          "description": "The password for the access key."
        },
        "displayName": {
          "type": "string",
          "description": "A friendly name for the key (e.g., 'Trainee 1')."
        },
        "createdAt": {
            "type": "string",
            "format": "date-time"
        }
      },
      "required": ["id", "username", "password", "displayName", "createdAt"]
    },
    "BrandCustomization": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "BrandCustomization",
      "type": "object",
      "description": "Stores the brand customization settings for a client's launch portal.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Should always be 'config'"
        },
        "primaryColor": {
          "type": "string",
          "description": "Primary color in HSL format (e.g., '262.1 83.3% 57.8%')."
        },
        "backgroundColor": {
          "type": "string",
          "description": "Background color in HSL format."
        },
        "accentColor": {
          "type": "string",
          "description": "Accent color in HSL format."
        },
        "foregroundColor": {
          "type": "string",
          "description": "Text color in HSL format."
        },
        "logoUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL for the client's logo."
        },
        "tagline": {
          "type": "string",
          "description": "Custom tagline or name for the portal."
        },
        "fontFamily": {
          "type": "string",
          "description": "The font family for the portal.",
          "enum": ["Montserrat", "Arial", "Times New Roman", "Inter", "Georgia", "Space Grotesk"]
        }
      },
      "required": ["id"]
    },
    "Asset": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Asset",
      "type": "object",
      "description": "A custom feature or module exclusive to a client.",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": ["id", "title", "description"]
    },
    "OpaCustomer": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "OpaCustomer",
      "type": "object",
      "description": "Represents a customer in the OPAC Tracker.",
      "properties": {
        "id": {
          "type": "string"
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "formerCompany": {
          "type": "string"
        },
        "planDetails": {
          "type": "string"
        },
        "dateLeft": {
          "type": "string",
          "format": "date"
        },
        "phoneNumber": {
          "type": "string"
        },
        "extraInfo": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": ["id", "firstName", "lastName"]
    },
    "Message": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Message",
      "type": "object",
      "description": "Represents a message to be sent by the Twilio extension.",
      "properties": {
        "to": {
          "type": "string",
          "description": "The recipient's phone number in E.164 format."
        },
        "body": {
          "type": "string",
          "description": "The content of the message to be sent."
        },
        "delivery": {
          "type": "object",
          "description": "A field managed by the extension to track message status.",
          "properties": {
            "state": {
              "type": "string",
              "enum": ["PENDING", "PROCESSING", "SUCCESS", "ERROR"]
            },
            "startTime": {
              "type": "string",
              "format": "date-time"
            },
            "endTime": {
              "type": "string",
              "format": "date-time"
            },
            "error": {
              "type": "string"
            }
          }
        }
      },
      "required": ["to", "body"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/entities/User"
          },
          "description": "Collection to store user profiles. Only the authenticated user can read/write their own profile.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier of the user."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}/clients/{clientId}",
        "definition": {
          "entityName": "Client",
          "schema": {
            "$ref": "#/entities/Client"
          },
          "description": "Subcollection to store clients for a specific user.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier of the user who owns the client."
            },
            {
              "name": "clientId",
              "description": "The unique identifier of the client."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}/clients/{clientId}/accessKeys/{accessKeyId}",
        "definition": {
          "entityName": "AccessKey",
          "schema": { "$ref": "#/entities/AccessKey" },
          "description": "Subcollection to store temporary access keys for a client.",
          "params": [
            { "name": "userId", "description": "The user owner of the client." },
            { "name": "clientId", "description": "The client the key belongs to." },
            { "name": "accessKeyId", "description": "The unique document ID of the key." }
          ]
        }
      },
       {
        "path": "/users/{userId}/clients/{clientId}/customization/{customizationId}",
        "definition": {
          "entityName": "BrandCustomization",
          "schema": { "$ref": "#/entities/BrandCustomization" },
          "description": "Stores brand customization for a specific client portal. The document ID should be a singleton, like 'config'.",
          "params": [
            { "name": "userId", "description": "The user owner." },
            { "name": "clientId", "description": "The client being customized." },
            { "name": "customizationId", "description": "Singleton ID, e.g., 'config'." }
          ]
        }
      },
      {
        "path": "/users/{userId}/clients/{clientId}/assets/{assetId}",
        "definition": {
          "entityName": "Asset",
          "schema": { "$ref": "#/entities/Asset" },
          "description": "Stores custom assets for a specific client portal.",
          "params": [
            { "name": "userId", "description": "The user owner." },
            { "name": "clientId", "description": "The client being customized." },
            { "name": "assetId", "description": "Unique ID for the asset." }
          ]
        }
      },
      {
        "path": "/users/{userId}/clients/{clientId}/opacCustomers/{customerId}",
        "definition": {
          "entityName": "OpaCustomer",
          "schema": {
            "$ref": "#/entities/OpaCustomer"
          },
          "description": "Subcollection to store OPAC tracker customers for a specific client.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier of the user who owns the client."
            },
            {
              "name": "clientId",
              "description": "The unique identifier of the client."
            },
            {
              "name": "customerId",
              "description": "The unique identifier of the OPAC customer."
            }
          ]
        }
      },
      {
        "path": "/messages/{messageId}",
        "definition": {
          "entityName": "Message",
          "schema": {
            "$ref": "#/entities/Message"
          },
          "description": "Collection that the Twilio 'Send Message' extension listens to. New documents trigger a message.",
          "params": [
            {
              "name": "messageId",
              "description": "The unique identifier for the message document."
            }
          ]
        }
      }
    ],
    "reasoning": "The Firestore structure is designed to be secure and scalable. The root `users` collection contains profiles for admins and managers. The `clients` subcollection under a user allows for clear ownership. The new `accessKeys` subcollection under each client securely stores the credentials created by a manager for their specific client, ensuring they are logically grouped and easy to manage."
  }
}

    
    