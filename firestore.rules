
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // This function checks if the requesting user is the owner of the client document
    // by traversing up the resource path.
    function isClientOwner() {
      let userId = request.path[2];
      return isOwner(userId);
    }
    
    function isManagerOfClient() {
        // Path: /users/{userId}/clients/{clientId}/...
        let ownerId = request.path[2];
        let clientRef = get(/databases/$(database)/documents/users/$(ownerId));
        // A manager is someone who has an `assignedClientId` that matches the {clientId} in the path.
        // This rule is tricky because we don't know the manager's UID directly from the path.
        // A better approach is to check if the current user has the 'manager' role and their assignedClientId matches.
        // This requires a read to the current user's profile.
        let currentUserProfile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        let requestedClientId = request.path[4]; // assuming /users/{ownerId}/clients/{clientId}

        // We need to get the displayId from the actual client document to compare.
        let clientDoc = get(/databases/$(database)/documents/users/$(ownerId)/clients/$(requestedClientId)).data;

        return isSignedIn() 
                && currentUserProfile.role == 'manager' 
                && currentUserProfile.assignedClientId == clientDoc.displayId;
    }


    function getRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function isAdmin(userId) {
      return getRole(userId) == 'admin';
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin(request.auth.uid);
      
      allow create: if isSignedIn();

      allow update: if isOwner(userId) // Allow user to update their own non-sensitive data
                      || isAdmin(request.auth.uid); // Allow admin to update any user
      
      allow delete: if isAdmin(request.auth.uid);
    }

    match /users/{userId}/clients/{clientId} {
      // Admins and the direct owner can manage clients.
      allow get, list, create, update, delete: if isOwner(userId) || isAdmin(request.auth.uid);
    }

    match /users/{userId}/clients/{clientId}/accessKeys/{accessKeyId} {
        // The owner of the client (admin) or an assigned manager can manage access keys.
        allow read, list, create, delete: if isOwner(userId) || isManagerOfClient();
        // No update allowed, keys should be created/deleted.
    }

    match /users/{userId}/clients/{clientId}/customization/{customizationId} {
      // Admins and the direct owner can manage customization.
      allow get, list, create, update, delete: if isOwner(userId) || isAdmin(request.auth.uid);
    }
  }
}
