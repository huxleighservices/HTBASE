/**
 * @fileoverview Firestore Security Rules for HTBase.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for all user-specific data
 * while allowing public read access to client information.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only to the authenticated user.
 * - /users/{userId}/clients/{clientId}: Stores clients associated with a specific user. Accessible only by the owning user.
 * - /users/{userId}/clients/{clientId}/sessions/{sessionId}: Stores training sessions for a specific client, accessible only by the owning user.
 * - /users/{userId}/landingPages/{landingPageId}: Stores customizable landing pages owned by users. Accessible only by the owning user.
 *
 * Key Security Decisions:
 * - User data is strictly segregated and accessible only to the owning user.
 * - `list` operations are generally restricted to the owner for user-specific collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles. Only the authenticated user can read/write their own profile.
     * @path /users/{userId}
     * @allow (get, create, update, delete, list) if the user is the owner of the profile.
     * @deny (get, create, update, delete, list) if the user is not the owner of the profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure clients for a specific user.
     * @path /users/{userId}/clients/{clientId}
     * @allow (get, create, update, delete, list) if the user is the owner of the client.
     * @deny (get, create, update, delete, list) if the user is not the owner of the client.
     * @principle Enforces document ownership for writes within a user's data tree.
     */
    match /users/{userId}/clients/{clientId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure training sessions for a specific client.
     * @path /users/{userId}/clients/{clientId}/sessions/{sessionId}
     * @allow (get, create, update, delete, list) if the user is the owner of the session.
     * @deny (get, create, update, delete, list) if the user is not the owner of the session.
     * @principle Enforces document ownership for writes within a user's data tree.
     */
    match /users/{userId}/clients/{clientId}/sessions/{sessionId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure landing pages owned by a specific user.
     * @path /users/{userId}/landingPages/{landingPageId}
     * @allow (get, create, update, delete, list) if the user is the owner of the landing page.
     * @deny (get, create, update, delete, list) if the user is not the owner of the landing page.
     * @principle Enforces document ownership for writes within a user's data tree.
     */
    match /users/{userId}/landingPages/{landingPageId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}