/**
 * @fileoverview Firestore Security Rules for HTBase.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model, meaning users can only
 * access data explicitly associated with their user ID. This is achieved through
 * path-based authorization.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only to the owning user.
 * - /users/{userId}/clients/{clientId}: Stores client data, accessible only to the owning user.
 * - /users/{userId}/clients/{clientId}/sessions/{sessionId}: Stores session data for clients, accessible only to the owning user.
 * - /users/{userId}/landingPages/{landingPageId}: Stores landing pages, accessible only to the owning user.
 *
 * Key Security Decisions:
 * - No public data access is allowed.
 * - User listing is implicitly denied (no top-level collection access).
 * - Data validation is relaxed to allow for rapid prototyping.  Only critical
 *   fields required for authorization are validated.
 *
 * Denormalization for Authorization:
 *  - The `userId` is encoded in the path for `clients`, `sessions` and `landingPages`,
 *    avoiding the need to duplicate this information in the document itself.
 *
 * Structural Segregation:
 *  - Private user data is stored under the `/users/{userId}` path, ensuring
 *    that only the owning user can access it.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows a user to read and write their own user profile.
     * @path /users/{userId}
     * @allow (create) - Authenticated user with ID matching the document ID.
     * @allow (get, list, update, delete) - Authenticated user with ID matching the document ID.
     * @deny (create) - Authenticated user with ID not matching the document ID.
     * @deny (get, list, update, delete) - Unauthenticated user.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Listing all users is not permitted.
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows a user to manage their clients.
     * @path /users/{userId}/clients/{clientId}
     * @allow (create) - Authenticated user with ID matching the userId path.
     * @allow (get, list, update, delete) - Authenticated user with ID matching the userId path.
     * @deny (create, get, list, update, delete) - Authenticated user with ID not matching the userId path.
     * @deny (create, get, list, update, delete) - Unauthenticated user.
     * @principle Enforces path-based ownership.
     */
    match /users/{userId}/clients/{clientId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows a user to manage training sessions for their clients.
     * @path /users/{userId}/clients/{clientId}/sessions/{sessionId}
     * @allow (create) - Authenticated user with ID matching the userId path.
     * @allow (get, list, update, delete) - Authenticated user with ID matching the userId path.
     * @deny (create, get, list, update, delete) - Authenticated user with ID not matching the userId path.
     * @deny (create, get, list, update, delete) - Unauthenticated user.
     * @principle Enforces path-based ownership.
     */
    match /users/{userId}/clients/{clientId}/sessions/{sessionId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows a user to manage their landing pages.
     * @path /users/{userId}/landingPages/{landingPageId}
     * @allow (create) - Authenticated user with ID matching the userId path.
     * @allow (get, list, update, delete) - Authenticated user with ID matching the userId path.
     * @deny (create, get, list, update, delete) - Authenticated user with ID not matching the userId path.
     * @deny (create, get, list, update, delete) - Unauthenticated user.
     * @principle Enforces path-based ownership.
     */
    match /users/{userId}/landingPages/{landingPageId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}