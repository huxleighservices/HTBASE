/**
 * @file Firebase Security Rules for HTBase Portal.
 *
 * @corePhilosophy:
 *   This ruleset enforces a strict user-ownership model. Each user can only access
 *   their own data, preventing unauthorized access to other users' information.
 *   All `create` operations are limited only for sign-in.
 *
 * @dataStructure:
 *   The data is organized under the `/users/{userId}` path. Each user has their own
 *   subcollections for `landingPages` and `portalCustomizations`. This hierarchical
 *   structure simplifies the rules and enforces clear ownership.
 *
 * @keySecurityDecisions:
 *   - **User Creation**: User documents can only be created upon sign-in. Anonymous users can not create a profile.
 *   - **Path-Based Ownership**: All access control decisions are based on the `userId`
 *     in the path, ensuring that only the user with the matching `auth.uid` can
 *     access the data.
 *   - **No User Listing**: Listing the `/users` collection is disallowed.
 *   - **Schema Enforcement**: This ruleset does NOT fully validate the data schema to allow for prototyping.
 *
 * @denormalizationForAuthorization:
 *   No denormalization is needed because the path-based ownership model allows
 *   for simple and efficient security rules without requiring extra data reads.
 *
 * @structuralSegregation:
 *   User-specific data is stored in separate subcollections under the `/users/{userId}`
 *   path, ensuring clear segregation and simplifying security rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects against unauthorized access to the `users` collection.
     * @path /users/{userId}
     * @allow (create) User signs in and creates their profile.
     * @deny (create) Anonymous user tries to create a profile
     * @deny (get, list, update, delete) Any request that is not the owner.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isOwner(userId);
      allow list: if false; // Listing all users is not permitted.
      //IMPORTANT: `create` is triggered when a user signs in for the first time
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Secures the `landingPages` subcollection under a user.
     * @path /users/{userId}/landingPages/{landingPageId}
     * @allow (create, get, update, delete, list) Owner access.
     * @deny Any request that is not the owner.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/landingPages/{landingPageId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Secures the `portalCustomizations` subcollection under a user.
     * @path /users/{userId}/portalCustomizations/{portalCustomizationId}
     * @allow (create, get, update, delete, list) Owner access.
     * @deny Any request that is not the owner.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/portalCustomizations/{portalCustomizationId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
       allow list: if get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
  }
}